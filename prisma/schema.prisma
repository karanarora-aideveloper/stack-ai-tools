generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tool {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String
  icon         String?
  logoUrl      String?
  domain       String?
  description  String
  pricingModel String
  priceClass   String
  link         String
  rating       Float    @default(4.8)
  reviewsCount Int      @default(120)
  tags         String[]
  badge            String?
  featured         Boolean  @default(false)
  status           String   @default("approved") // "approved" or "pending"
  editorialReview  String?
  zapierVerdict    String?
  authoritySummary String?
  pros             String[]
  cons             String[]
  bestFor          String?
  verifiedBy       String?
  affiliateLink    String?
  affiliateStatus  String?
  commissionRate   String?
  affiliateNetwork String?
  affiliateNotes   String?
  createdAt        DateTime @default(now())
}

model Prompt {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  targetAI        String
  category        String
  prompt          String
  outputType      String   @default("text") // "image" | "code" | "text"
  outputImageUrl  String?
  outputPreview   String?
  author          String?  @default("Curated")
  aspectRatio     String?  @default("16:9")
  tags            String[]
  status          String   @default("approved")
  createdAt       DateTime @default(now())
}

model Article {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId       Int      @unique
  slug           String   @unique
  title          String
  category       String
  primaryKeyword String
  searchVolume   Int      @default(0)
  difficulty     Int      @default(0)
  cpc            String   @default("0")
  readTime       String   @default("5 min read")
  featured       Boolean  @default(false)
  excerpt        String
  imageUrl       String
  author         String   @default("Karan Arora")
  authorRole     String   @default("Founder & Chief AI Architect")
  publishedAt    String
  updatedAt      String
  tags           String[]
  status         String   @default("approved")
  createdAt      DateTime @default(now())
}

model Subscriber {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  email              String    @unique
  status             String    @default("active") // "active" | "unsubscribed"
  source             String?   @default("website")
  lastSentAt         DateTime?
  lastProviderUsed   String?
  emailsSentCount    Int       @default(0)
  createdAt          DateTime  @default(now())
}

model EmailCampaign {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  subject         String
  previewText     String?
  bodyHtml        String
  scheduledFor    DateTime?
  sentAt          DateTime?
  status          String    @default("draft") // "draft" | "sent" | "failed"
  totalRecipients Int       @default(0)
  successfulSent  Int       @default(0)
  failedCount     Int       @default(0)
  providersUsed   String[]  @default([])
  createdAt       DateTime  @default(now())
}

model EmailDispatchLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId  String?
  recipient   String
  provider    String   // "brevo" | "resend" | "mailersend" | "mailjet" | "sendgrid" | "smtp" | "simulation"
  status      String   // "delivered" | "failed" | "simulated"
  errorMsg    String?
  sentAt      DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType       String   // "pageview" | "outbound_click" | "prompt_copy" | "session_churn"
  path            String
  toolSlug        String?
  toolName        String?
  category        String?
  destinationUrl  String?
  sessionId       String?
  durationSeconds Int?
  scrollDepth     Int?
  referrer        String?
  createdAt       DateTime @default(now())
}
